[Unit]
Description=Bound PV database growth while preserving numeric samples
After=pv-dashboard.service

[Service]
Type=oneshot
User=pv-dashboard
Group=pv-dashboard
WorkingDirectory=/opt/pv-dashboard
ExecStart=/usr/local/sbin/pv-storage-maintenance
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pv-dashboard/data
MemoryMax=256M
CPUQuota=20%
